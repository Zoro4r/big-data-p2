# Copiar a .env y cambiar las contraseñas (./local.sh lo hace solo y las genera al azar).
# El archivo .env no se sube al repo. Guía de cada variable: docs/local.md

# Wikis a procesar (separadas por coma)
WIKIS=enwiki,eswiki

# Contacto que se envía a Wikimedia en el User-Agent (lo pide su política de uso)
WIKI_USER_AGENT=UTEC-BigData-P2/0.1 (contacto: tu-correo@ejemplo.com)

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=cambiar-mongo

# Neo4j (usuario fijo: neo4j)
NEO4J_PASSWORD=cambiar-neo4j

# Airflow: usuario de la interfaz web y base de metadatos
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar-airflow
AIRFLOW_DB_PASSWORD=cambiar-postgres
# Usuario con el que corre Airflow. En Linux pon tu UID (comando: id -u); en Mac y Windows deja 50000.
AIRFLOW_UID=50000

# ---- Opcionales (descomentar para usarlas) ----

# Contraseña del dashboard. Vacía = sin contraseña (lo normal en local).
# DASHBOARD_PASSWORD=

# Memoria de Neo4j. Bájalas si Docker tiene poca RAM; súbelas si el grafo crece mucho.
# NEO4J_HEAP=512m
# NEO4J_PAGECACHE=256m

# true = el DAG arranca pausado (en local, ./local.sh lo activa); false = arranca activo.
# DAGS_PAUSED=true
