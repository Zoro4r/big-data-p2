{
  "_comment": "Esquema de MongoDB (base wikipipe). Lo aplica db/create_schemas.py o wikipipe.mongo.ensure_schema().",
  "collections": {
    "events": {
      "_comment": "Un documento por evento del stream, con todos sus campos originales más 'derived'. _id = meta.id",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": [
            "_id",
            "type",
            "wiki",
            "title",
            "user",
            "meta",
            "derived"
          ],
          "properties": {
            "type": {
              "enum": [
                "edit",
                "new",
                "categorize",
                "log"
              ]
            },
            "wiki": {
              "bsonType": "string"
            },
            "title": {
              "bsonType": "string"
            },
            "user": {
              "bsonType": "string"
            },
            "bot": {
              "bsonType": "bool"
            },
            "derived": {
              "bsonType": "object",
              "required": [
                "event_dt",
                "date",
                "hour",
                "user_type",
                "page_key"
              ],
              "properties": {
                "event_dt": {
                  "bsonType": "date"
                },
                "user_type": {
                  "enum": [
                    "bot",
                    "temporal",
                    "ip",
                    "registrado"
                  ]
                }
              }
            }
          }
        }
      },
      "indexes": [
        {
          "keys": [
            [
              "derived.event_dt",
              1
            ]
          ],
          "name": "por_fecha"
        },
        {
          "keys": [
            [
              "wiki",
              1
            ],
            [
              "type",
              1
            ],
            [
              "derived.event_dt",
              -1
            ]
          ],
          "name": "por_wiki_tipo_fecha"
        },
        {
          "keys": [
            [
              "user",
              1
            ],
            [
              "derived.event_dt",
              -1
            ]
          ],
          "name": "por_editor"
        },
        {
          "keys": [
            [
              "derived.page_key",
              1
            ]
          ],
          "name": "por_pagina"
        },
        {
          "keys": [
            [
              "derived.revert_target",
              1
            ]
          ],
          "name": "por_revertido",
          "sparse": true
        },
        {
          "keys": [
            [
              "wiki",
              1
            ],
            [
              "derived.event_dt",
              -1
            ],
            [
              "_id",
              -1
            ]
          ],
          "name": "por_wiki_fecha_id"
        }
      ]
    },
    "events_rejected": {
      "_comment": "Eventos descartados en la limpieza, con el motivo.",
      "indexes": [
        {
          "keys": [
            [
              "reason",
              1
            ]
          ],
          "name": "por_motivo"
        },
        {
          "keys": [
            [
              "ventana_dt",
              1
            ]
          ],
          "name": "por_fecha",
          "sparse": true
        }
      ]
    },
    "pipeline_runs": {
      "_comment": "Una ejecución del DAG por ventana horaria. _id = inicio de la ventana (ISO).",
      "indexes": [
        {
          "keys": [
            [
              "window_start_dt",
              -1
            ]
          ],
          "name": "por_ventana"
        }
      ]
    },
    "stream_state": {
      "_comment": "Marcador de la capa rápida (servicio stream): último evento leído, para retomar sin huecos al reiniciar.",
      "indexes": []
    },
    "stream_cobertura": {
      "_comment": "Tramos que la capa rápida leyó sin huecos (inicio y fin = fechas de eventos, en UTC). La capa por lotes lee una hora de MongoDB solo si un tramo la cubre.",
      "indexes": [
        {
          "keys": [
            [
              "inicio",
              1
            ],
            [
              "fin",
              -1
            ]
          ],
          "name": "por_inicio"
        }
      ]
    },
    "pipeline_windows": {
      "_comment": "Bloqueos por hora, marcas de escritura y manifiestos de editores para reconstruir Cassandra. No expirar estos documentos.",
      "indexes": []
    }
  }
}
